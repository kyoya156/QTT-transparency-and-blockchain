# Copy this file to .env (same folder) and fill it in. .env is git-ignored. Never commit a key.
# Private key of the DEPLOYER wallet: 64 hex characters, with or without a leading 0x. Not the 0x... address.
DEPLOYER_KEY=
# Public address (0x + 40 hex characters) allowed to record transactions: the LISTENER wallet.
RECORDER_ADDRESS=
# Optional. Defaults to the public Base Sepolia endpoint.
# Only for scripts/grant-recorder.js: the deployed contract address.
CONTRACT_ADDRESS=
BASE_SEPOLIA_RPC=
