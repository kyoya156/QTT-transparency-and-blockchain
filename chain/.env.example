# Copy this file to .env (same folder) and fill it in. .env is git-ignored. Never commit a key.
# Private key of the DEPLOYER wallet: 64 hex characters, with or without a leading 0x. Not the 0x... address.
DEPLOYER_KEY=
# Public address (0x + 40 hex characters) allowed to record transactions: the LISTENER wallet.
RECORDER_ADDRESS=
# Optional. Defaults to the public Base Sepolia endpoint.
# Only for scripts/grant-recorder.js: the deployed contract address.
CONTRACT_ADDRESS=
BASE_SEPOLIA_RPC=
# Python bridge (transparency/chain.py). Private key of the LISTENER wallet (the RECORDER_ADDRESS above).
LISTENER_KEY=
# Long random string, e.g. python -c "import secrets;print(secrets.token_hex(32))". Never change it once records exist.
REFID_SECRET=
# SePay test receiver (transparency/sepay_receiver.py). Set one; the HMAC secret is preferred.
SEPAY_WEBHOOK_SECRET=
SEPAY_API_KEY=
# Listener (transparency/listener.py). Record id prefix; default TEST- (dashboard skips these). Leave TEST- until real use.
LISTENER_ID_PREFIX=TEST-
