        <!-- ===================== LAYER 1: DATA SOURCES ===================== -->
        <mxCell id="src_bank" value="SAO KÊ NGÂN HÀNG (CSV)&#10;Vietcombank + VPBank&#10;238.173 dòng · 2018 → 2026" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="0">
          <mxGeometry x="60" y="90" width="270" height="80" as="geometry" />
