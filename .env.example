# Copy to .env and fill in. Never commit .env.

# --- database (docker compose maps host port 5434 to avoid clashing with a local Postgres) ---
DATABASE_URL=postgresql+psycopg://qne:qne@localhost:5434/qne_chatbot

# --- crawler contract (see docs/PLAN.md section 3) ---
CRAWLER_BASE_URL=http://localhost:8000
CRAWLER_API_KEY=change-me
CRAWLER_PAGE_SIZE=500
# only these two are ever pulled; the client also hard-codes web|post as a privacy floor
SYNC_SOURCE_TYPES=web,post

# --- sync source: "file" for a crawler JSON export, "http" for the live endpoint ---
SYNC_SOURCE=file
SYNC_FILE=data/chunks.json

# --- embeddings (free, local, Vietnamese-tuned) ---
EMBED_PROVIDER=local
EMBED_MODEL=AITeamVN/Vietnamese_Embedding_v2
EMBED_DIM=1024
EMBED_DEVICE=cpu
# float32 normally; set float16 on a machine with little free RAM or a small pagefile
EMBED_DTYPE=float32
EMBED_BATCH_SIZE=16

# --- retrieval (tune these against the eval set, not by intuition) ---
RETRIEVAL_K=5
RETRIEVAL_POOL=20
RRF_K=60
# cosine cutoff for "enough evidence". Measured on the fixture: real question 0.612,
# nonsense 0.461 - do not lower this without the eval set to prove it.
RETRIEVAL_MIN_SIMILARITY=0.55
# fallback bar when there is no vector signal at all; ts_rank has no IDF here
RETRIEVAL_MIN_TS_RANK=0.30

# --- local crawler stub (mocks/crawler_stub.py) ---
MOCK_CRAWLER_KEY=dev-local-key
MOCK_CRAWLER_FILE=tests/fixtures/chunks_sample.json

# --- LLM (used from M3; keep the thin client base-url/model only) ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=

# --- api ---
API_PORT=8080
