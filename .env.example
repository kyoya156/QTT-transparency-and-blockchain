# Copy thanh .env roi dien. KHONG commit .env.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg2://qnebot:change-me@db:5432/qnebot
DATABASE_URL_LOCAL=postgresql+psycopg2://qnebot:change-me@localhost:5434/qnebot

# Crawler (the crawler repo): /api/public/chunks. Khoa phai trung PUBLIC_API_KEY ben crawler.
# Crawler chay tren may host (Docker Desktop): host.docker.internal.
CRAWLER_URL=http://host.docker.internal:8000
CRAWLER_API_KEY=

# Embedding cuc bo (mien phi): kich thuoc vector phai khop model (Vietnamese_Embedding_v2 = 1024).
EMBED_DIM=1024

# LLM (dung tu M2/M3). De trong BASE_URL = OpenAI.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
EMBED_MODEL=AITeamVN/Vietnamese_Embedding_v2

# Embedding device/dtype: float32 normally; float16 when RAM/pagefile is tight (BGE-M3 ~2.2 GB)
EMBED_DEVICE=cpu
EMBED_DTYPE=float32

# Nguong "du bang chung" do tren fixture: cau hoi that 0.612, cau vo nghia 0.461.
# Khong ha thap khi chua co eval set.
RETRIEVAL_MIN_SIMILARITY=0.55
RETRIEVAL_MIN_TS_RANK=0.30
