# Copy thanh .env roi dien. KHONG commit .env.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg2://qnebot:change-me@db:5432/qnebot
DATABASE_URL_LOCAL=postgresql+psycopg2://qnebot:change-me@localhost:5434/qnebot

# Crawler (QNE-knowledge-base): /api/public/chunks. Khoa phai trung PUBLIC_API_KEY ben crawler.
# Crawler chay tren may host (Docker Desktop): host.docker.internal.
CRAWLER_URL=http://host.docker.internal:8000
CRAWLER_API_KEY=

# Embedding: kich thuoc vector phai khop model (text-embedding-3-small = 1536).
EMBED_DIM=1536

# LLM (dung tu M2/M3). De trong BASE_URL = OpenAI.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
EMBED_MODEL=text-embedding-3-small
